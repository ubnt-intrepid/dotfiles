{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(git merge-base:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(dotnet build:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(cargo test:*)",
      "Bash(cargo install:*)",
      "Bash(dotnet test:*)"
    ],
    "defaultMode": "default"
  },
  "enabledPlugins": {},
  "outputStyle": "Learning",
  "promptSuggestionEnabled": false
}
