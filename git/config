[alias]
  ar  = archive
  br  = branch
  cl  = clone
  cm  = commit
  df  = diff
  dfi = diff --cached
  fa  = fetch --all
  pl  = pull
  ps  = push
  sm  = submodule
  ss  = stash
  st  = status --short --branch
  sw  = switch
  swc = switch -c
  wt  = worktree

  branches  = branch -a
  tags      = tag
  stashes   = stash list
  unstage   = restore --staged --
  discard   = restore --
  uncommit  = reset --mixed HEAD~
  amend     = commit --amend
  graph     = log --graph --all --format=format:'%Cgreen%h %Creset• %<(40,trunc)%s (%cN, %cr) %Cred%d'

; for difftastic
  ddiff = -c diff.external=difft diff
  dlog  = -c diff.external=difft log --ext-diff
  dshow = -c diff.external=difft show --ext-diff
  ddf   = ddiff
  ddfi  = ddiff --cached

[core]
  ; untracked ファイル検出結果をディレクトリ単位でキャッシュする
  ; (core.fsmonitor は常駐プロセスが増えるため、必要なリポジトリで個別に有効化する)
  untrackedCache = true

[safe]
  ; 作業ツリー内に埋め込まれた bare リポジトリを暗黙に検出しない
  ; (clone したリポジトリ内に悪意ある config を持つ bare リポジトリを仕込まれた場合のコード実行対策)
  ; bare リポジトリを操作する際は --git-dir または GIT_DIR で明示する
  bareRepository = explicit

[transfer]
  ; fetch/clone/receive 時に受信オブジェクトを検証する (不正なパスや .gitmodules などの多層防御)
  ; 古いリポジトリで弾かれる場合は fetch.fsck.<msg-id> = ignore で個別に除外する
  fsckObjects = true

[diff]
  algorithm      = histogram
  colorMoved     = plain
  mnemonicPrefix = true
  renames        = copies

[merge]
  tool  = vimdiff
  conflictStyle = zdiff3

[init]
  defaultBranch = main

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[column]
  ui = auto

[fetch]
  prune = true

[push]
  default = current
  autoSetupRemote = true

[pull]
  ff = only

[rebase]
  ; rebase -i 時に fixup!/squash!/amend! コミットを自動で並べ替える (--autosquash 相当)
  ; autoSquash = true
  ; rebase 時に途中にある他のブランチも追従させる (--update-refs 相当)
  ; updateRefs = true

[rerere]
  ; conflict の解消結果を記録し、同じ conflict に再適用する
  ; enabled = true

[url "git@github.com:"]
  pushinsteadof = https://github.com/

[url "git@gitlab.com:"]
  pushinsteadof = https://gitlab.com/

