[alias]
  ar  = archive
  br  = branch
  cl  = clone
  cm  = commit
  co  = checkout
  df  = diff
  dfi = diff --cached
  fa  = fetch --all
  pl  = pull
  ps  = push
  sm  = submodule
  ss  = stash
  st  = status --short --branch
  sw  = switch
  swc = switch -c
  wt  = worktree

  branches  = branch -a
  tags      = tag
  stashes   = stash list
  unstage   = reset -q HEAD --
  discard   = checkout --
  uncommit  = reset --mixed HEAD~
  amend     = commit --amend
  graph     = log --graph --all --format=format:'%Cgreen%h %Creset• %<(40,trunc)%s (%cN, %cr) %Cred%d'

; for difftastic
  ddiff = -c diff.external=difft diff
  dlog  = -c diff.external=difft log --ext-diff
  dshow = -c diff.external=difft show --ext-diff
  ddf   = ddiff
  ddfi  = ddiff --cached

[core]
  preloadindex  = true
  fscache       = true
  editor        = ${EDITOR:-vi}
  autocrlf      = input
  safecrlf      = false
  symlinks      = true

[safe]
  ; 作業ツリー内に埋め込まれた bare リポジトリを暗黙に検出しない
  ; (clone したリポジトリ内に悪意ある config を持つ bare リポジトリを仕込まれた場合のコード実行対策)
  ; bare リポジトリを操作する際は --git-dir または GIT_DIR で明示する
  bareRepository = explicit

[merge]
  ff    = false
  tool  = vimdiff
  conflictStyle = zdiff3

[i18n]
  filesEncoding = utf-8

[init]
  defaultBranch = main

[fetch]
  prune = true

[push]
  default = current

[pull]
  ff = only
  prune = true

[url "git@github.com:"]
  pushinsteadof = https://github.com/

[url "git@gitlab.com:"]
  pushinsteadof = https://gitlab.com/

